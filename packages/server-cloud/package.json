{
  "name": "@daoyin/harness-server-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./src/sqlite-repository.ts",
      "default": "./dist/sqlite-repository.js"
    },
    "./postgres": {
      "types": "./src/postgres-repository.ts",
      "default": "./dist/postgres-repository.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@daoyin/harness-agent-core": "*",
    "@daoyin/harness-contracts": "*",
    "@daoyin/harness-protocol": "*",
    "@daoyin/harness-tools": "*",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.12.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1"
  }
}
